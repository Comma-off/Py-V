04000893  # 0x00000014  ADDI x17,x0,64         li      a7, 64              # a7 = syscall "write"
00000073  # 0x00000018  ECALL                  ecall
00000513  # 0x0000001C  ADDI x10,x0,0          li      a0, 0               # exit status 0
05D00893  # 0x00000020  ADDI x17,x0,93         li      a7, 93              # a7 = syscall "exit"
