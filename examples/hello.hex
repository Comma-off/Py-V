00000597  # 0x00000000  AUIPC x11,0x0          la      a1, message         # a1 = buffer address (auipc + addi)
02858593  # 0x00000004  ADDI x11,x11,40        la      a1, message         # a1 = buffer address (auipc + addi)
00000637  # 0x00000008  LUI  x12,0x0           li      a2, message_len     # a2 = length
00F60613  # 0x0000000C  ADDI x12,x12,15        li      a2, message_len     # a2 = length
